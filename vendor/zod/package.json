{
  "name": "@deepseek-ai/zod",
  "description": "Trimmed fork of zod 4.6.7 vendored for the DeepSeek Harness schema seam (v4 classic API + core, JSON Schema conversion, en locale)",
  "version": "4.6.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "vendor/zod"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./v4": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "sideEffects": false,
  "author": "Colin McDonnell <zod@colinhacks.com>",
  "license": "MIT"
}
