{
  "name": "@deepseek-ai/dsh-git",
  "description": "Agentic git plumbing: the host ctx.git service (diff capture/parsing, hunk staging, commit/push/log over the subprocess seam) backing the commit and review tools in @deepseek-ai/dsh-tool-git",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/git/git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./service": {
      "types": "./lib/types/service.d.ts",
      "default": "./lib/types/service.js"
    },
    "./diff": {
      "types": "./lib/types/diff.d.ts",
      "default": "./lib/types/diff.js"
    },
    "./topo-sort": {
      "types": "./lib/types/topo-sort.d.ts",
      "default": "./lib/types/topo-sort.js"
    },
    "./lock-files": {
      "types": "./lib/types/lock-files.d.ts",
      "default": "./lib/types/lock-files.js"
    },
    "./vcs": {
      "types": "./lib/types/vcs.d.ts",
      "default": "./lib/types/vcs.js"
    },
    "./repo-lock": {
      "types": "./lib/types/repo-lock.d.ts",
      "default": "./lib/types/repo-lock.js"
    },
    "./worktree": {
      "types": "./lib/types/worktree.d.ts",
      "default": "./lib/types/worktree.js"
    },
    "./conventional": {
      "types": "./lib/types/conventional/index.d.ts",
      "default": "./lib/types/conventional/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "effect": "4.0.0-rc.118"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-subprocess": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*"
  }
}
