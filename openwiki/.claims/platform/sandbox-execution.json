    {
      "id": "claim_d80003634eba40b296786a86a4cacf8d",
      "statement": "The sandbox group confines subprocess execution to a file-effect policy (read-only, workspace-write, danger-full-access), delivered by the confinement service (sandbox/, ctx.sandbox), per-platform backends (sandbox-local/), the shared policy resolver (sandbox-policy/, ctx.sandboxPolicy), and the Windows write-restriction backend (sandbox-windows-acl/, win32 backend); denied confined calls can retry through a user-approved one-time escalation, and confinement is same-world only.",
      "evidence": [
        {
          "resource": "repo://packages/sandbox/README.md#L12-L12",
          "version": "repo-lines-v1:sha256:29ce6d1a2983826ae9a7d1a08a696d4b08468988aefdef66b1188e958b05a856:"
        }
