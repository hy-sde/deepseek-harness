  "claims": [
    {
      "id": "claim_868a4a064e704c1e8fd52f5500476796",
      "statement": "The session group makes an agent's conversation durable and reusable outside the live loop: the persistence seam stores the event log and restores it on resume, the checkpoint policy keeps requests, tool side effects, and completed steps durable before the next action, projections serve whole log-derived values to client carriers, titles name each session from its content, and telemetry reports session activity; JSONL is the shipped persistence default and SQLite an opt-in single-database backend, while session-query is a sibling group.",
      "evidence": [
        {
          "resource": "repo://packages/session/README.md#L10-L12",
          "version": "repo-lines-v1:sha256:fa43261ada597b1666c56b53d753a82ee4487d1bca07f17430fbc34c0f92444a:"
        }
      ]
    },
    {
      "id": "claim_4ea3d8bfc49d40e3a21b750d4106f0db",
      "statement": "The persistence family is session-persistence (ctx.sessionPersistence, the durable session-storage service), session-persistence-jsonl (append-only JSONL per session, optionally Zstandard-compressed), session-persistence-sqlite (all sessions in one SQLite database), session-checkpoint-policy (wraps ctx.llm and ctx.tools), and session-log-deepseek (contributes dsh_session_log); the projection family is session-projection (ctx.sessionProjections), session-projection-cache (ctx.sessionProjectionCache), and session-stats (the sessionStats unit).",
      "evidence": [
        {
          "resource": "repo://packages/session/README.md#L31-L43",
          "version": "repo-lines-v1:sha256:8740ffd1e9415661c21835054d43a4f8ccdf2d4cb66f7d6477ce1e16335e0e82:"
        }
      ]
    },
    {
      "id": "claim_7c1bad8047c7434c91ac06e4dd44ad4d",
      "statement": "dsh-session-persistence-jsonl stores each session in its own append-only JSONL log (checksummed Zstandard frames by default, raw newline-delimited lines when compression is disabled), serves the same logical SessionEvent stream as any persistence backend, returns the transcript path from locate(meta), and requires only a root directory.",
      "evidence": [
        {
          "resource": "repo://packages/session/session-persistence-jsonl/README.md#L10-L12",
          "version": "repo-lines-v1:sha256:ff30cfa4882d6f6e73f603be6fdf711ad1d194e239637f9c413149e8f484b75f:"
        }
      ]
    },
    {
      "id": "claim_009f40771e6440edbffefb4d068a299b",
      "statement": "dsh-session-projection serves whole current values of log-derived per-session state (history tail page and session/projection push frame) through a ctx.sessionProjections registry that folds every committed session event through registered projection units: a domain registers a pure computation unit (initial state, fold over events, optional client view), every served value is plain JSON validated against a schema, and a per-unit stateVersion anchors persisted-cache invalidation.",
      "evidence": [
