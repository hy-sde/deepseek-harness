          "version": "repo-lines-v1:sha256:52c1ba126dce6ac6650d716abaf079ddf5e7d2a688d5eab197c4010683f534e4:"
        }
      ]
    },
    {
      "id": "claim_2ce3aaa9943b47f28cd3fb1d11f84724",
      "statement": "The llm group packages are: llm/ (ctx.llm), llm-deepseek/ (the deepseek-official route with chat-completions, thinking, and image input), llm-pi-ai/ (configured provider routes through pi-ai catalogs and wire protocols), deepseek-llm-api-extensions/ (ctx.deepseekLlmApiExtensions top-level request fields), plugin-package-inventory-deepseek/ (the dsh_plugin_packages inventory), llm-retry/ (agent/request-error listener), and token-meter/ (ctx.tokenMeter).",
      "evidence": [
        {
          "resource": "repo://packages/llm/README.md#L23-L32",
