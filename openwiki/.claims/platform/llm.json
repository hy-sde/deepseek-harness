    {
      "id": "claim_44caa19bab3149f086d5e4128ccbe7eb",
      "statement": "dsh-llm is the provider-neutral model-call service: it registers provider adapters, streams one model call, lists and discovers models, resolves exact-model metadata and call defaults, and captures each provider's retry policy; it executes no retries and owns no provider wire logic, requests are deep-frozen before dispatch, and every request is logged so it stays reconstructable from the session log.",
      "evidence": [
        {
          "resource": "repo://packages/llm/llm/README.md#L10-L12",
          "version": "repo-lines-v1:sha256:e42cd52288f1d7efc9d56ab8bd4402d428fca486d32ef1066b3dde0eb98b2ef7:"
        }
      ]
    },
    {
      "id": "claim_c64d11bd770c47dc891b89299ff0815b",
      "statement": "A conversation is Messages and a message is an array of typed content blocks: the merge-extensible ContentBlockMap currently covers text, reasoning (thinking distinct from visible text), image (a durable image attachment), tool-call, and tool-result.",
      "evidence": [
        {
          "resource": "repo://docs/subsystems/llm-streaming.md#L11-L30",
          "version": "repo-lines-v1:sha256:329565db38ac612b21966c02219df3b36eed93d65940a26bff94242ce1517890:"
