    {
      "id": "claim_170ef6f998054daa9b2d6db6e4733c1c",
      "statement": "StreamChunk is a closed discriminated union of the raw streaming protocol: block-start, text-delta, reasoning-delta, tool-call-delta, block-end (carrying the fully assembled ContentBlock), usage (emitted before the terminal finish), and finish with replayState; index ties each delta to its block, and LlmRuntime.stream() normalizes an adapter throw to a terminal error or aborted finish.",
      "evidence": [
        {
          "resource": "repo://docs/subsystems/llm-streaming.md#L168-L217",
          "version": "repo-lines-v1:sha256:313fe7f34b8aeea902b61bc6dca38a2fed003101bd5b41fd069d52ba1521a8bf:"
        }
