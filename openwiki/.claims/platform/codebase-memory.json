    {
      "id": "claim_58208fe99ddc4aefad68541aed754e61",
      "statement": "The tool surface comprises codebase_list_projects, codebase_index_repository (mode=full|moderate|fast|cross-repo-intelligence), codebase_index_status, codebase_search_graph, codebase_query_graph (raw Cypher), codebase_trace_path (calls|data_flow|cross_service), codebase_get_code_snippet, codebase_get_graph_schema, codebase_get_architecture, codebase_search_code, codebase_detect_changes, codebase_manage_adr, codebase_ingest_traces, and the destructive codebase_delete_project.",
