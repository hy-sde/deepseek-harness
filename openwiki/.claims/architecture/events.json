  "claims": [
    {
      "id": "claim_fd5333c7bd1940b0802f3086d009bcfd",
      "statement": "The harness distinguishes three event domains: session events are durable facts appended to the session log and broadcast through `session/event`, agent events (`agent/*`) carry a live Agent (inbox, step, status, request, validation, continuation), and capability events attach policy and adapters to a seam (`fs/*`, `tools/*`, `telemetry/*`) without importing the loop.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L64-L70",
          "version": "repo-lines-v1:sha256:fa26fe5c72be9c73a3ed75a8378e7968805aaeb95f9f1abf601d55e8c0edb5ec:"
        }
      ]
    },
    {
      "id": "claim_b171cb6d575446afb0d093a579539d72",
      "statement": "`turn/*`, `step/*`, `user/message`, `assistant/*`, and `tool/*` are durable session events; the rest are live extension points across the three domains.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L95-L95",
