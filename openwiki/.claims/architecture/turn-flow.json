    {
      "id": "claim_be585d630bce4aa2b4eee368f13e94a9",
      "statement": "session.append(type, data, opts?) commits one typed event that snapshots and freezes the payload, validates it as lossless JSON, and notifies observers, while session.deriveMessages() projects the log into the Message[] the model sees incrementally and cached.",
