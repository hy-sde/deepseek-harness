  "claims": [
    {
      "id": "claim_0f01ea8fbd054b6ea7037366a41929c0",
      "statement": "A step is one model request plus the tools it calls, and a turn is zero or more steps that opens before its first input is claimed and closes once nothing is owed.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L76-L76",
          "version": "repo-lines-v1:sha256:b856ba204cad81e0550bf1975d4ff4a1bace25693365d53afbad66148471995a:"
        }
      ]
    },
    {
      "id": "claim_1592788ab82c4d4382dd53be7d481fbd",
      "statement": "The turn/step sequence is: turn/start, claim next-step input plus one queued message, assemble prompt sections and tool schemas, agent/pre-step (reject or enter), step/start, append entered messages as user/message, derive model history from the log, agent/request -> llm/stream -> assistant/chunk* -> assistant/message, tool/call* -> tools/pre-execute -> tools/execute -> tools/post-execute -> tool/result*, step/end, agent/turn-stopping, turn/end.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L78-L93",
          "version": "repo-lines-v1:sha256:c082795420746ad7642c1c08d6ca01ebec11ec39608493fc2d87bc41b1e8a003:"
        }
      ]
    },
    {
      "id": "claim_5519de4806134dd1afd5580d22474017",
      "statement": "turn/*, step/*, user/message, assistant/*, and tool/* are durable session events, while the rest are live extension points; agent/pre-step, agent/request, llm/stream and the three tools/* events are waterfalls whose listeners must call next() to delegate, and agent/turn-stopping is serial with no next().",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L95-L95",
          "version": "repo-lines-v1:sha256:22afd04697a4b5b5c828a3655f8171280b2b39db4081e09b4d8365482bac61bb:"
        }
      ]
    },
    {
      "id": "claim_5b389ba251824ce0aded969e1b7dccb3",
      "statement": "Input reaches the driver through one inbox: some messages wake it immediately, while injected context waits in the inbox until another message does.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L97-L97",
          "version": "repo-lines-v1:sha256:437a24ea1645cc2f77277563a0b1e03dffb9aca2787fea5f7b53e0b572ef4fd8:"
        }
      ]
    },
    {
      "id": "claim_c913358e9c7b42d794b204d1a409db81",
      "statement": "agent/pre-step decides what the model sees: listeners may rewrite claimed messages or reject them outright, and a rejected or empty first claim still closes a durable turn that spent no step; an enter decision may set startsRequestSeries, causing the loop to log a fresh request/header.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L99-L99",
          "version": "repo-lines-v1:sha256:7c5133051e88fe267431498fb5feed76feb27e665b05688df43bbb65b420bb43:"
        }
      ]
    },
    {
      "id": "claim_9739cbc7bf4a402faae14eddd55166ec",
      "statement": "The session log is the source of the context the model sees: deriveMessages() projects model history from it, raw assistant/chunk events preserve replay and UI fidelity, and fork, resume, transcripts, telemetry, and persistence all derive from this stream.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L105-L105",
          "version": "repo-lines-v1:sha256:4bae67f5ae28551d11d591f76175ac1dd9fb4147c31c979ff33a426ec7d7a956:"
        }
      ]
    },
    {
      "id": "claim_c47a422a8f6746aa85d7e090672a6a66",
      "statement": "Model-visible means logged: anything that reaches a model request must be reconstructable from the log, a runtime invariant asserts it, and a new model-visible input requires a new session event (extend SessionEventMap and render from the log).",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L107-L107",
