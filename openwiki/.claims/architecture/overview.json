  "claims": [
    {
      "id": "claim_2b7aa645790147b5a42b721941a51b28",
      "statement": "Cordis is the framework under dsh: plugins contribute services, typed events, and reversible effects to a shared context, and every part of the product is a plugin — the model adapter, the tool registry, the session log, and the agent loop — so each is replaceable from configuration and there is no privileged core to patch.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L9-L13",
          "version": "repo-lines-v1:sha256:2ecbcad6eb421c28790b70050f498ae136ff260fbd4dfede797c6096ff4be1d9:"
        }
      ]
    },
    {
      "id": "claim_020a56e442324cc099c7242b37872b79",
      "statement": "A profile is a named composition stored in the Harness home that lists the bundles it stacks, holds any out-of-tree plugins it installs, and keeps the user's own cordis.patch.yml; web, headless, sdk, sdk-minimal, and acp ship as profile templates.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L15-L24",
          "version": "repo-lines-v1:sha256:df1457cdaeeef76908156378a45f9a92060adca71a595540e7560e861418e9f6:"
        }
      ]
    },
    {
      "id": "claim_6164745551434acf9a04803847af698a",
      "statement": "Each profile or bundle declares itself in its own package.json under a `dsh` field: `dsh.profile` lists a profile's bundles and `dsh.bundle` points at a bundle's patch file.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L23-L24",
          "version": "repo-lines-v1:sha256:7dee11729399eb5f1eb1b1fc21f38e935c0b9ba4008d4b640b9c2138df38c6ba:"
        }
      ]
    },
    {
      "id": "claim_5e89921fb3e34978935cd6f6fdd7744b",
      "statement": "Composition layers apply to an empty entry list in this order: each bundle in the profile's listed order, then the profile's cordis.patch.yml, then the home-level one, then any `--patch` overlay; a patch targets a row by id and replaces its whole config or inserts new rows.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L28-L28",
          "version": "repo-lines-v1:sha256:01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b:"
        }
      ]
    },
    {
      "id": "claim_c2d5752013a94ba9bb15383984e9a193",
      "statement": "dsh-base is the shared first layer of the web, headless, sdk, and acp profiles (model adapters, tools, persistence, sandbox and approval policy, settings, credentials, telemetry), while dsh-sdk-minimal is the deliberate exception: one bundle owns its complete explicit SDK tree and does not apply dsh-base.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L26-L26",
          "version": "repo-lines-v1:sha256:01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b:"
        }
      ]
    },
    {
      "id": "claim_9aab90313e9e4844a5c61a144a1f5f32",
      "statement": "Custom profiles default to live patch reload; the shipped web profile is live, while headless, sdk, sdk-minimal, and acp apply all layers once at startup.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L30-L30",
          "version": "repo-lines-v1:sha256:01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b:"
        }
      ]
    },
    {
      "id": "claim_c289205f5f8e44008253677f25c335b3",
      "statement": "A profile lives at $DSH_HOME/profiles/<name> and combines installable bundles, its own cordis.patch.yml, and a `patchReload: live | startup` policy, where an omitted reload policy keeps the historical live default for custom profiles.",
      "evidence": [
