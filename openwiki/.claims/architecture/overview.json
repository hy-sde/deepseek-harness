    },
    {
      "id": "claim_d7e09ec030f3446882df9e6daef0afb1",
      "statement": "Every supported Node application starts at the dsh CLI with a named profile (dsh web, --profile headless, --profile sdk, --profile sdk-minimal, --profile acp), and verify-application-entrypoints rejects a Node application path that bypasses dsh.",
      "evidence": [
