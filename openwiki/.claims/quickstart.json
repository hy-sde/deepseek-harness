  "claims": [
    {
      "id": "claim_1299b4c3787547b7afa0b6f3c7a4dedc",
      "statement": "DeepSeek Harness (dsh) is an open-source agent harness developed by DeepSeek AI, built on an everything-is-a-plugin architecture powered by Cordis, and is in developer preview with compatibility-breaking changes expected.",
      "evidence": [
        {
          "resource": "repo://README.md#L5-L13",
          "version": "repo-lines-v1:sha256:f8b298c86eba6dc694c64c90fa8816618d532083c547d67a4c8b2c0bdb0ff094:"
        }
      ]
    },
    {
      "id": "claim_5d35efeed9a94887a922f5a74559cbbe",
      "statement": "Cordis is the framework under dsh: plugins contribute services, typed events, and reversible effects to a shared context, and every part of the product is a plugin including the model adapter, the tool registry, the session log, and the agent loop itself, so each is replaceable from configuration.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L9-L13",
          "version": "repo-lines-v1:sha256:2ecbcad6eb421c28790b70050f498ae136ff260fbd4dfede797c6096ff4be1d9:"
        }
      ]
    },
    {
      "id": "claim_7b9ae630d5e8493a8b7f3256844a6105",
      "statement": "A profile is a named composition stored in the Harness home listing the bundles it stacks, out-of-tree plugins it installs, and the user's cordis.patch.yml (web, headless, sdk, sdk-minimal, and acp ship as templates); a bundle is a distribution format for Cordis config rows and the code they mount; layers apply in order: each bundle, then the profile's cordis.patch.yml, then the home-level one, then any --patch overlay.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L19-L27",
          "version": "repo-lines-v1:sha256:94d0e40892594953bdb28fb17a6e3408f158f3404a47cf8752a9f2a229851bf9:"
        }
      ]
    },
    {
      "id": "claim_291135f0233c4a07b420d92013fa5da2",
      "statement": "Running from npm is npx @deepseek-ai/dsh web; the command starts the Web UI at http://127.0.0.1:3080 by default and opens it in the default browser for a local launch, with --no-open to run without opening a browser.",
      "evidence": [
        {
          "resource": "repo://README.md#L23-L27",
          "version": "repo-lines-v1:sha256:b96ca6314d3d7f2a5fbce6dc9d4ab3130997c0fd4934fbfdeabc1e910d731738:"
        }
      ]
    },
    {
      "id": "claim_7521c048bfb449fab3bd73c7304e8726",
      "statement": "Running from source is git clone, pnpm install, pnpm run build, then pnpm dsh web; pnpm run build prepares the repository artifacts and pnpm dsh web uses those built artifacts without rebuilding.",
      "evidence": [
        {
          "resource": "repo://README.md#L33-L41",
          "version": "repo-lines-v1:sha256:375fb0b48670a93a15d25d464d6879b5e9600e6680b07332c72502cfd5b7f767:"
